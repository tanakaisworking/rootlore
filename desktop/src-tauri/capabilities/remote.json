{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-report",
  "description": "公開中のRootloreから、動作報告・MCPの応答・メニューの表示言語と保存可否・エラーの報告の設定を更新する",
  "windows": ["main"],
  "remote": {
    "urls": ["https://rootlore.app/*", "http://127.0.0.1:37420/*"]
  },
  "permissions": ["allow-report", "allow-mcp-result", "allow-set-menu-state", "allow-set-error-reports"]
}
